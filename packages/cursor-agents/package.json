{
  "name": "@rpgtracker/cursor-agents",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test src/__tests__/scanner-context.test.ts src/__tests__/head-branch-resolution.test.ts src/__tests__/remediation-brief.test.ts src/__tests__/model-fallback.test.ts src/__tests__/dep-classification.test.ts src/__tests__/maintenance-queue.test.ts src/__tests__/maintenance-dispatch.test.ts src/__tests__/run-summary.test.ts",
    "test:watch": "node --import tsx --watch --test src/__tests__",
    "security-triage": "tsx src/security-triage.ts",
    "security-triage:local": "CURSOR_RUNTIME=local tsx src/security-triage.ts",
    "security-triage:cloud": "CURSOR_RUNTIME=cloud tsx src/security-triage.ts",
    "fix-attempt": "tsx src/fix-attempt.ts",
    "fix-attempt:cloud": "CURSOR_RUNTIME=cloud tsx src/fix-attempt.ts",
    "daily-quality-digest": "tsx src/daily-quality-digest.ts",
    "dep-assess": "tsx src/dep-assessment.ts",
    "maintenance-queue": "tsx src/maintenance-queue-run.ts",
    "maintenance-dispatch": "tsx src/maintenance-dispatch-run.ts",
    "weekly-metrics": "tsx src/weekly-metrics.ts"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.13",
    "@rpgtracker/tsconfig": "workspace:*",
    "@types/node": "^20",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
