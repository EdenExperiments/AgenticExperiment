{
  "name": "rpgtracker-platform",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:ci": "turbo test --concurrency=1",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "test:go": "cd apps/api && go test ./...",
    "lint": "turbo lint",
    "validate:skills": "node scripts/validate-skills.mjs",
    "validate:agents": "node scripts/validate-agents.mjs",
    "validate:flows": "node scripts/validate-flows.mjs",
    "validate:cursor": "pnpm validate:skills && pnpm validate:agents && pnpm validate:flows",
    "format": "turbo format",
    "check:precommit": "pnpm validate:cursor && pnpm lint && turbo test --concurrency=1 && pnpm test:go",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "turbo": "^2.9.14"
  },
  "engines": {
    "node": ">=20.20.2",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "next": "16.2.6"
    }
  }
}
