{
  "name": "rpgtracker-platform",
  "private": true,
  "scripts": {
    "build": "nx run-many -t build --exclude=api",
    "dev": "nx run-many -t dev --parallel=8",
    "test": "nx run-many -t test --exclude=api",
    "test:ci": "nx run-many -t test --parallel=1 --exclude=api",
    "test:coverage": "nx run-many -t test:coverage --parallel=1 --exclude=api",
    "test:go": "nx test api",
    "lint": "nx run-many -t lint --exclude=api",
    "format": "nx run-many -t format",
    "check:precommit": "pnpm lint && nx run-many -t test --parallel=1 --exclude=api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "nx": "^21.6.4"
  },
  "engines": {
    "node": ">=20.20.2",
    "pnpm": ">=9.15.9"
  },
  "packageManager": "pnpm@9.15.9",
  "pnpm": {
    "overrides": {
      "next": "16.2.6"
    }
  }
}
