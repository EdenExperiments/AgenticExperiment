{
  "name": "rpgtracker-platform",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:coverage": "turbo test --concurrency=1 -- --coverage",
    "test:go": "cd apps/api && go test ./...",
    "lint": "turbo lint",
    "validate:skills": "node scripts/validate-skills.mjs",
    "format": "turbo format",
    "check:precommit": "pnpm validate:skills && pnpm lint && turbo test --concurrency=1 && pnpm test:go",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.0.0"
}
